{
  "name": "vertical-cam-studio",
  "productName": "垂直摄像头工作室",
  "version": "0.1.0",
  "private": true,
  "description": "Vertical camera photo capture, screen capture, crop/zoom/rotate and save to a folder",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "test": "node --test",
    "pack": "electron-builder --dir && node scripts/verify-installer.mjs",
    "dist": "electron-builder && node scripts/verify-installer.mjs",
    "dist:nsis": "node scripts/dist-nsis.mjs",
    "verify": "node scripts/verify-installer.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "cropperjs": "1.6.2",
    "electron": "^38.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.verticalcamstudio",
    "productName": "Vertical Cam Studio",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vertical Cam Studio",
      "artifactName": "VerticalCamStudio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VerticalCamStudio-Portable-${version}.${ext}"
    }
  }
}
